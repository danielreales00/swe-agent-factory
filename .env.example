# Copy to .env and fill in the values. .env is gitignored.

# --- Required ---

# Telegram bot token from @BotFather (one bot per factory deployment).
BRIDGE_TG_TOKEN=

# Comma-separated list of Telegram numeric user IDs allowed to talk to the
# bot. Use @userinfobot or any chat-id helper to look yours up.
BRIDGE_ALLOWED_USER_IDS=

# Pi's LLM credential. Same key you'd export for `pi` standalone.
ANTHROPIC_API_KEY=

# --- Optional ---

# Where to read targets/<name>.yml from. Default: ./targets
# BRIDGE_TARGETS_DIR=./targets

# Pi provider + model. Defaults match the S1 setup.
# BRIDGE_PI_PROVIDER=anthropic
# BRIDGE_PI_MODEL=

# Where pi writes session JSONLs (per chat task).
# BRIDGE_PI_SESSIONS_ROOT=.bridge/sessions

# Pi reasoning level: off | minimal | low | medium | high | xhigh
# BRIDGE_PI_THINKING=

# How long to wait for a permission-button tap before auto-denying.
# (Set via code right now; surfaced here as a reminder.)
